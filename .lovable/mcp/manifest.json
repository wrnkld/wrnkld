{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "wrnkld-mcp",
      "version": "0.1.0",
      "title": "Matthew Stevens — Portfolio"
    },
    "tools": [
      {
        "name": "about",
        "title": "About Matthew Stevens",
        "description": "Get a short bio and contact info for Matthew Stevens.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_books",
        "title": "List books",
        "description": "List books from Matthew Stevens's reading list. Optionally filter to only recommended titles or by author (case-insensitive substring match).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "recommendedOnly": {
              "description": "If true, return only recommended books.",
              "type": "boolean"
            },
            "author": {
              "description": "Case-insensitive substring match on author name.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_records",
        "title": "List records",
        "description": "List records (albums) from Matthew Stevens's collection. Optionally filter by artist or by year range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "artist": {
              "description": "Case-insensitive substring match on artist name.",
              "type": "string"
            },
            "yearFrom": {
              "description": "Include records with year >= yearFrom.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "yearTo": {
              "description": "Include records with year <= yearTo.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_content",
        "title": "List site content",
        "description": "List Matthew Stevens's portfolio content by category: work (case studies), words (essays), or side (side projects).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "default": "all",
              "description": "Which category to list.",
              "type": "string",
              "enum": [
                "work",
                "words",
                "side",
                "all"
              ]
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
